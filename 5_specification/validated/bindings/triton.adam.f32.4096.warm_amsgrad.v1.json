        {"target": "/amsgrad", "literal": true, "basis": "the kernel stores max(old_vmax,new_v) and uses it in the denominator"},
        {"target": "/decoupled_weight_decay", "literal": false, "basis": "weight decay is accumulated in both moments"},
        {"target": "/foreach", "literal": false, "basis": "the bound task is one complete parameter transition"},
        {"target": "/fused", "literal": false, "basis": "the binding makes no claim about PyTorch's internal fused implementation"},
        {"target": "/capturable", "literal": false, "basis": "the selected task fixes a noncapturable public transition"},
        {"target": "/differentiable", "literal": false, "basis": "the selected task is nondifferentiable"}
