        {"target": "/lr", "literal": 0.125, "basis": "the kernel uses the exact binary value 0.125"},
        {"target": "/beta1", "literal": 0.5, "basis": "the kernel uses the exact binary value 0.5"},
        {"target": "/beta2", "literal": 0.75, "basis": "the kernel uses the exact binary value 0.75"},
        {"target": "/eps", "literal": 0.25, "basis": "the kernel adds the exact binary value 0.25 outside sqrt"},
