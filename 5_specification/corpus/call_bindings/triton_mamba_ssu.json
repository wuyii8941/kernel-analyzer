        {"target": "/z", "source": "/tensor_arguments/z/before", "conversion": "tensor_values"},
        {"target": "/dt_bias", "source": "/tensor_arguments/dt_bias/before", "conversion": "tensor_values"},
        {"target": "/dt_softplus", "literal": true, "basis": "the kernel applies the torch threshold-20 softplus after adding dt_bias"},
        {"target": "/state_batch_indices", "literal": null, "basis": "each input row updates its same-numbered state slot"},
        {"target": "/dtype", "literal": "f32", "basis": "the wrapper requires physical float32 tensors"}
