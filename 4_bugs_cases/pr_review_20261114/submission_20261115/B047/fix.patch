From 0c63e26844816dc450ca3639f3c9a66884a28830 Mon Sep 17 00:00:00 2001
From: wuyii8941 <wuyii8941@gmail.com>
Date: Sun, 15 Nov 2026 00:54:40 +0800
Subject: [PATCH] Fix L1 gradients at zero residual

---
 attorch/p_loss_kernels.py   |  2 +-
 tests/test_p_loss_layers.py | 19 +++++++++++++++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/attorch/p_loss_kernels.py b/attorch/p_loss_kernels.py
index 36d37d7..d08d2c6 100644
--- a/attorch/p_loss_kernels.py
+++ b/attorch/p_loss_kernels.py
@@ -127,7 +127,7 @@ def p_loss_backward_kernel(
         input_grad = tl.where(tl.abs(diff) < param, diff / param, tl.where(0 <= diff, 1, -1))
 
     elif p_loss == 1:
-        input_grad = tl.where(0 <= diff, 1, -1)
+        input_grad = tl.where(diff == 0, 0, tl.where(0 <= diff, 1, -1))
 
     elif p_loss == 2:
         input_grad = 2 * diff
diff --git a/tests/test_p_loss_layers.py b/tests/test_p_loss_layers.py
index 8776af7..8700579 100644
--- a/tests/test_p_loss_layers.py
+++ b/tests/test_p_loss_layers.py
@@ -48,3 +48,22 @@ def test_p_loss_layers(
     assert_close((attorch_input.grad, pytorch_input.grad),
                  (attorch_target.grad, pytorch_target.grad),
                  rtol=1e-3, atol=1e-3)
+
+
+@pytest.mark.parametrize('reduction', ['none', 'mean', 'sum'])
+@pytest.mark.parametrize('mixed', [False, True])
+def test_l1_zero_residual_gradient(reduction, mixed):
+    values = [0., -0., -2., 2., 0., -1., 1., 0.] if mixed else [0.] * 8
+    x = torch.tensor(values, device='cuda', requires_grad=True)
+    target = torch.zeros_like(x, requires_grad=True)
+    ref_x = x.detach().clone().requires_grad_()
+    ref_target = target.detach().clone().requires_grad_()
+    actual = attorch.L1Loss(reduction=reduction)(x, target)
+    expected = nn.L1Loss(reduction=reduction)(ref_x, ref_target)
+    upstream = (torch.arange(1, 9, device='cuda', dtype=x.dtype)
+                if reduction == 'none' else torch.tensor(.5, device='cuda'))
+    actual.backward(upstream)
+    expected.backward(upstream)
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    torch.testing.assert_close(x.grad, ref_x.grad, rtol=0, atol=0)
+    torch.testing.assert_close(target.grad, ref_target.grad, rtol=0, atol=0)
-- 
