Date: Sun, 15 Nov 2026 01:09:53 +0800
Subject: [PATCH] fix: use undropped probabilities for varlen dropout gradients

---
 src/flag_gems/ops/flash_attention_backward.py |   6 +-
 ...ash_attention_varlen_dropout_derivative.py | 164 ++++++++++++++++++
 2 files changed, 167 insertions(+), 3 deletions(-)
 create mode 100644 tests/test_flash_attention_varlen_dropout_derivative.py

diff --git a/src/flag_gems/ops/flash_attention_backward.py b/src/flag_gems/ops/flash_attention_backward.py
index 2f6924a7d..a02e33e00 100644
--- a/src/flag_gems/ops/flash_attention_backward.py
+++ b/src/flag_gems/ops/flash_attention_backward.py
@@ -732,7 +732,6 @@ def _flash_attn_bwd_varlen_dq_fused(
             rand_vals = tl.rand(seed, rng_off)
             drop_mask = rand_vals > dropout_p
             dp = tl.where(drop_mask, dp * drop_scale, 0.0)
-            p = tl.where(drop_mask, p * drop_scale, 0.0)
 
         ds = p * (dp - Di[:, None]) * sm_scale
         dq = dq + tl.dot(ds.to(q.dtype), k)
@@ -983,6 +982,7 @@ def _flash_attn_bwd_varlen_dkv(
         p = tl.exp(s - Li[:, None])
         dp = tl.dot(do, tl.trans(v)).to(tl.float32)
 
+        p_drop = p
         if IS_DROPOUT:
             rng_off = (
                 base_offset
@@ -994,11 +994,11 @@ def _flash_attn_bwd_varlen_dkv(
             rand_vals = tl.rand(seed, rng_off)
             drop_mask = rand_vals > dropout_p
             dp = tl.where(drop_mask, dp * drop_scale, 0.0)
-            p = tl.where(drop_mask, p * drop_scale, 0.0)
+            p_drop = tl.where(drop_mask, p * drop_scale, 0.0)
 
         ds = p * (dp - Di[:, None]) * sm_scale
         dk = dk + tl.dot(tl.trans(ds.to(q.dtype)), q)
-        dv = dv + tl.dot(tl.trans(p.to(q.dtype)), do)
+        dv = dv + tl.dot(tl.trans(p_drop.to(q.dtype)), do)
 
     tl.store(
         dK
diff --git a/tests/test_flash_attention_varlen_dropout_derivative.py b/tests/test_flash_attention_varlen_dropout_derivative.py
new file mode 100644
index 000000000..100e577ba
--- /dev/null
+++ b/tests/test_flash_attention_varlen_dropout_derivative.py
@@ -0,0 +1,164 @@
