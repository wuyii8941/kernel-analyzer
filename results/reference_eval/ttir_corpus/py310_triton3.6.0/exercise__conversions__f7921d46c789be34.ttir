    %h = arith.truncf %x_6 : tensor<256xf32> to tensor<256xf16> loc(#loc39)
    %b = arith.truncf %x_6 : tensor<256xf32> to tensor<256xbf16> loc(#loc40)
    %f8 = tt.fp_to_fp %x_6, rounding = rtne : tensor<256xf32> -> tensor<256xf8E5M2> loc(#loc41)
    %0 = tt.splat %Y16 : !tt.ptr<f16> -> tensor<256x!tt.ptr<f16>> loc(#loc12)
