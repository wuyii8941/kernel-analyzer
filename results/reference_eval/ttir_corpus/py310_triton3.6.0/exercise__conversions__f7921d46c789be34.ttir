    tt.store %1, %h, %mask_4 : tensor<256x!tt.ptr<f16>> loc(#loc13)
    %2 = tt.splat %YBF : !tt.ptr<bf16> -> tensor<256x!tt.ptr<bf16>> loc(#loc14)
