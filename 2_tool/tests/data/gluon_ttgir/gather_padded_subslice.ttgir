    %in_offs_5 = arith.addi %in_offs_3, %in_offs_4 : tensor<64x64xi32, #blocked>
    %in_data = tt.splat %matrix_ptr : !tt.ptr<f32> -> tensor<64x64x!tt.ptr<f32>, #blocked>
    %in_data_6 = tt.addptr %in_data, %in_offs_5 : tensor<64x64x!tt.ptr<f32>, #blocked>, tensor<64x64xi32, #blocked>
    %in_data_7 = tt.load %in_data_6 : tensor<64x64x!tt.ptr<f32>, #blocked>
    %smem = ttg.local_alloc : () -> !ttg.memdesc<64x64xf32, #shared, #smem, mutable>
    ttg.local_store %in_data_7, %smem : tensor<64x64xf32, #blocked> -> !ttg.memdesc<64x64xf32, #shared, #smem, mutable>
    %smem_slice = ttg.memdesc_subslice %smem[48, 16] : !ttg.memdesc<64x64xf32, #shared, #smem, mutable> -> !ttg.memdesc<16x16xf32, #shared, #smem, mutable, 64x64>
    %slice_offs_m = tt.make_range {end = 16 : i32, start = 0 : i32} : tensor<16xi32, #ttg.slice<{dim = 1, parent = #blocked}>>
