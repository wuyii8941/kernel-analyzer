    %slice_offs_n = tt.make_range {end = 16 : i32, start = 0 : i32} : tensor<16xi32, #ttg.slice<{dim = 0, parent = #blocked}>>
    %slice_offs_n_9 = tt.expand_dims %slice_offs_n {axis = 0 : i32} : tensor<16xi32, #ttg.slice<{dim = 0, parent = #blocked}>> -> tensor<1x16xi32, #blocked>
    %idx_offs = arith.muli %slice_offs_m_8, %cst_0 : tensor<16x1xi32, #blocked>
