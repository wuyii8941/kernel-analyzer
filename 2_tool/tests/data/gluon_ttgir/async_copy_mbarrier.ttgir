    %mask = tt.splat %xnumel : i32 -> tensor<32x1xi32, #blocked>
    %mask_3 = arith.cmpi slt, %xindex_1, %mask : tensor<32x1xi32, #blocked>
    %0 = arith.muli %xindex_1, %cst_0 : tensor<32x1xi32, #blocked>
    %1 = tt.splat %inp : !tt.ptr<f32> -> tensor<32x1x!tt.ptr<f32>, #blocked>
    %2 = tt.addptr %1, %0 : tensor<32x1x!tt.ptr<f32>, #blocked>, tensor<32x1xi32, #blocked>
    %3 = tt.broadcast %2 : tensor<32x1x!tt.ptr<f32>, #blocked> -> tensor<32x32x!tt.ptr<f32>, #blocked>
    %4 = tt.broadcast %yindex_2 : tensor<1x32xi32, #blocked> -> tensor<32x32xi32, #blocked>
    %5 = tt.addptr %3, %4 : tensor<32x32x!tt.ptr<f32>, #blocked>, tensor<32x32xi32, #blocked>
    %6 = tt.broadcast %mask_3 : tensor<32x1xi1, #blocked> -> tensor<32x32xi1, #blocked>
    %7 = ttg.async_copy_global_to_local %5, %smem mask %6 {cachePolicy = #tt.cache_policy<cache_modifier = none, eviction_policy = evict_last>} : tensor<32x32x!tt.ptr<f32>, #blocked> -> <32x32xf32, #shared, #smem, mutable>
    %mbar = ttg.local_alloc : () -> !ttg.memdesc<1xi64, #shared1, #smem, mutable>
    ttng.init_barrier %mbar, 1 : !ttg.memdesc<1xi64, #shared1, #smem, mutable>
    ttng.arrive_barrier %mbar, 1, %true : !ttg.memdesc<1xi64, #shared1, #smem, mutable>
    ttng.wait_barrier %mbar, %c0_i32, %true : !ttg.memdesc<1xi64, #shared1, #smem, mutable>
    ttng.async_copy_mbarrier_arrive %mbar : !ttg.memdesc<1xi64, #shared1, #smem, mutable>
    ttng.wait_barrier %mbar, %c0_i32, %true : !ttg.memdesc<1xi64, #shared1, #smem, mutable>
    ttng.arrive_barrier %mbar, 1, %true : !ttg.memdesc<1xi64, #shared1, #smem, mutable>
