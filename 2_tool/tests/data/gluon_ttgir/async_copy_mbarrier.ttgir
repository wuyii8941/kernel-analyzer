    %8 = tt.splat %out : !tt.ptr<f32> -> tensor<32x1x!tt.ptr<f32>, #blocked>
    %9 = tt.addptr %8, %0 : tensor<32x1x!tt.ptr<f32>, #blocked>, tensor<32x1xi32, #blocked>
    %10 = tt.broadcast %9 : tensor<32x1x!tt.ptr<f32>, #blocked> -> tensor<32x32x!tt.ptr<f32>, #blocked>
