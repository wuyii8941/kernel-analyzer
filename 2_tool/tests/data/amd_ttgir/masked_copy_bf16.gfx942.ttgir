#blocked = #ttg.blocked<{sizePerThread = [1], threadsPerWarp = [64], warpsPerCTA = [4], order = [0]}>
module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "hip:gfx942", "ttg.threads-per-warp" = 64 : i32} {
  tt.func public @kernel(%out_ptr: !tt.ptr<bf16> {tt.divisibility = 16 : i32}, %a_ptr: !tt.ptr<bf16> {tt.divisibility = 16 : i32}, %shape.0: i32 {tt.divisibility = 16 : i32}) attributes {noinline = false} {
    %shape.0_0 = arith.extsi %shape.0 : i32 to i64
    %arange = tt.make_range {end = 64 : i32, start = 0 : i32} : tensor<64xi32, #blocked>
    %block = amdg.buffer_load %a_ptr[%arange] : !tt.ptr<bf16> -> tensor<64xbf16, #blocked>
    %0 = arith.extsi %arange : tensor<64xi32, #blocked> to tensor<64xi64, #blocked>
    %1 = tt.splat %shape.0_0 : i64 -> tensor<64xi64, #blocked>
    %2 = arith.cmpi slt, %0, %1 : tensor<64xi64, #blocked>
    amdg.buffer_store %block, %out_ptr[%arange], %2 : !tt.ptr<bf16> -> tensor<64xbf16, #blocked>
    tt.return
  }
}
