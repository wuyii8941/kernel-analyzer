    %2 = tt.addptr %1, %0 : tensor<4x4x!tt.ptr<f32>>, tensor<4x4xi32>
    %3 = tt.atomic_rmw fadd, acq_rel, gpu, %2, %val_9, %cst : (tensor<4x4x!tt.ptr<f32>>, tensor<4x4xf32>, tensor<4x4xi1>) -> tensor<4x4xf32>
