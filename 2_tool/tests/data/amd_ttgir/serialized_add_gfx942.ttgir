#blocked = #ttg.blocked<{sizePerThread = [1], threadsPerWarp = [64], warpsPerCTA = [4], order = [0]}>
module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "hip:gfx942", "ttg.threads-per-warp" = 64 : i32} {
  tt.func public @serialized_add(%data: !tt.ptr<f32>, %Lock: !tt.ptr<i32>) attributes {noinline = false} {
    %true = arith.constant true
    %cst = arith.constant dense<1.000000e+00> : tensor<128xf32, #blocked>
    %num1 = arith.constant dense<1> : tensor<1xi32, #blocked>
    %c1_i32 = arith.constant 1 : i32
    %num0 = arith.constant dense<0> : tensor<1xi32, #blocked>
    %num0_0 = tt.unsplat %num0 : tensor<1xi32, #blocked>
    %num1_1 = tt.unsplat %num1 : tensor<1xi32, #blocked>
    %ptrs = tt.make_range {end = 128 : i32, start = 0 : i32} : tensor<128xi32, #blocked>
    scf.while : () -> () {
      %3 = tt.atomic_cas acq_rel, gpu, %Lock, %num0_0, %num1_1 : (!tt.ptr<i32>, i32, i32) -> i32
      %4 = arith.cmpi eq, %3, %c1_i32 : i32
      scf.condition(%4)
    } do {
      scf.yield
    }
    %0 = amdg.buffer_load %data[%ptrs] : !tt.ptr<f32> -> tensor<128xf32, #blocked>
    %1 = arith.addf %0, %cst : tensor<128xf32, #blocked>
    amdg.buffer_store %1, %data[%ptrs] : !tt.ptr<f32> -> tensor<128xf32, #blocked>
    ttg.barrier all
    %2 = tt.atomic_rmw exch, acq_rel, gpu, %Lock, %num0_0, %true : (!tt.ptr<i32>, i32, i1) -> i32
    tt.return
  }
}
