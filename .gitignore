# Python/tooling
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
*.egg-info/
.venv/
venv/

# Local execution and compiler products
cache/
torch_compile_debug/
logs/
*.log
*.cubin
*.ptx
*.ttir
*.ttgir
*.llir
*.so

# Environments, local archive, and downloaded third-party binaries
archive/
third_party/
data/**
!data/README.md
!data/error_sources.example.json
!data/external_datasets/*.json
!data/external_datasets/*.jsonl
!data/external_datasets/*.manifest.json
*.pt
*.pth
*.safetensors
*.bin
*.npz
*.npy

# Raw run outputs are local-only. Only the compact final package is versioned.
results/**
!results/README.md
!results/final/
!results/final/**

# Generated bytecode accidentally present in old retained artifacts.
results/**/__pycache__/
results/**/*.pyc
results/**/*.pt
results/**/*.pth
results/**/*.cubin
results/**/*.so
results/**/*.ptx
results/**/*.ttir
results/**/*.ttgir
results/**/*.llir
